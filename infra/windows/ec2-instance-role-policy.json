{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GlueRead",
      "Effect": "Allow",
      "Action": ["glue:GetDatabases", "glue:GetDatabase", "glue:GetTables", "glue:GetTable", "glue:GetPartitions"],
      "Resource": "*"
    },
    {
      "Sid": "AthenaReadExecute",
      "Effect": "Allow",
      "Action": ["athena:StartQueryExecution", "athena:GetQueryExecution", "athena:GetQueryResults", "athena:StopQueryExecution", "athena:ListWorkGroups", "athena:GetWorkGroup"],
      "Resource": "*"
    },
    {
      "Sid": "SourceDataRead",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": ["arn:aws:s3:::<SOURCE_DATA_BUCKET>", "arn:aws:s3:::<SOURCE_DATA_BUCKET>/*"]
    },
    {
      "Sid": "AthenaResults",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": ["arn:aws:s3:::<ATHENA_RESULTS_BUCKET>", "arn:aws:s3:::<ATHENA_RESULTS_BUCKET>/*"]
    },
    {
      "Sid": "SemanticArtifactsOptional",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject", "s3:ListBucket"],
      "Resource": ["arn:aws:s3:::<SEMANTIC_BUCKET>", "arn:aws:s3:::<SEMANTIC_BUCKET>/*"]
    },
    {
      "Sid": "DynamoControlOptional",
      "Effect": "Allow",
      "Action": ["dynamodb:GetItem", "dynamodb:PutItem", "dynamodb:DeleteItem", "dynamodb:Query", "dynamodb:UpdateItem", "dynamodb:DescribeTable"],
      "Resource": "arn:aws:dynamodb:<REGION>:<ACCOUNT_ID>:table/<LEARNING_TABLE>"
    },
    {
      "Sid": "BedrockOptional",
      "Effect": "Allow",
      "Action": ["bedrock:InvokeModel", "bedrock:ListFoundationModels", "bedrock:ListInferenceProfiles", "bedrock:GetInferenceProfile"],
      "Resource": "*"
    },
    {
      "Sid": "SnsAlertsOptional",
      "Effect": "Allow",
      "Action": ["sns:Publish"],
      "Resource": "arn:aws:sns:<REGION>:<ACCOUNT_ID>:<TOPIC_NAME>"
    }
  ]
}

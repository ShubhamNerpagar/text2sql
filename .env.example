# ============================================================
# Data Intelligence Platform 7.0.1 - Windows EC2 TEST profile
# Runs directly on Windows with Python/Uvicorn. No Docker.
# This profile is intended for testing, not public production exposure.
# ============================================================
APP_NAME=Data Intelligence Platform
APP_ENV=development
APP_MODE=aws
DEFAULT_MARKET=
DEFAULT_DATA_SOURCE=athena

# AWS credentials: use an EC2 IAM instance profile. Do not put access keys here.
AWS_REGION=ap-south-1
BEDROCK_REGION=ap-south-1
BEDROCK_MODEL=apac.amazon.nova-2-lite-v1:0
ATHENA_CATALOG=AwsDataCatalog
ATHENA_OUTPUT=
ATHENA_WORKGROUP=primary
DB_PREFIX=

# For the first EC2 test you can keep platform state on the Windows disk.
# Later set SEMANTIC_BUCKET/LEARNING_TABLE and PERSIST_LOCAL_STATE=false.
SEMANTIC_BUCKET=
ONTOLOGY_KEY=runtime/ontology.json
RELATIONSHIPS_KEY=runtime/relationships.json
WORKSPACE_KEY_PREFIX=runtime/workspaces
GRAPH_KEY_PREFIX=runtime/semantic-graphs
LEARNING_TABLE=
PERSIST_LOCAL_STATE=true

ALLOW_SAMPLE_VALUES=false
# Synthetic execution is reserved for explicit test fixtures. Ask always requires an LLM.
ENABLE_SAMPLE_EXECUTION=false
ALLOW_INFERRED_ANALYTICS=false
QUERY_TIMEOUT_SECONDS=180
MAX_RESULT_ROWS=5000
MAX_LEARNING_RECORDS=500
PLANNER_MIN_CONFIDENCE=0.48
MAX_PLANNER_TABLES=6

GRAPH_TOP_K=12
GRAPH_EMBEDDING_DIMENSIONS=128
GRAPH_CANDIDATE_MIN_CONFIDENCE=0.68
GRAPH_MIN_AUTHORITY=0.20
GRAPH_FRESHNESS_HALF_LIFE_DAYS=180
GRAPH_EXPLORER_MAX_NODES=500

# Hash embeddings let the app boot without Bedrock during the first smoke test.
# Change to bedrock after AWS permissions/model access are verified.
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
EMBEDDING_DIMENSIONS=1024
EMBEDDING_NORMALIZE=true
EMBEDDING_FALLBACK=true

# Direct EC2 testing uses development identity headers.
# Do NOT use this configuration for public production traffic.
SECURITY_ENABLED=true
ALLOW_DEV_IDENTITY_HEADERS=true
AUTH_MODE=dev_headers
DEFAULT_ROLES=analyst
ADMIN_ROLES=admin,semantic_admin
TRUSTED_ROLES_HEADER=x-authenticated-roles
CORS_ORIGINS=http://localhost:8000,http://127.0.1.1:8000

MAX_QUERY_BYTES=5368709120
QUERY_COST_PER_TB_USD=5.0
MAX_LLM_CALLS_PER_QUERY=3

# Optional non-Athena sources.
POSTGRES_URL=
SNOWFLAKE_URL=
DATABRICKS_URL=
ACTION_LAMBDA_ARN=

# Optional scheduled-report alerts.
REPORT_ALERT_SNS_TOPIC_ARN=
REPORT_WORKER_TOKEN=

# Optional telemetry during first test.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=data-intelligence-platform
OTEL_EXPORTER_OTLP_ENDPOINT=

# ALB/OIDC fields are intentionally blank in direct test mode.
ALB_EXPECTED_SIGNER_ARN=
ALB_EXPECTED_CLIENT_ID=
IDENTITY_ROLE_CLAIM=roles

# Phase 5 job queue: sqlite (single host) or dynamodb (shared, requires AWS and LEARNING_TABLE)
# JOB_QUEUE_BACKEND is preferred; legacy PHASE5_QUEUE_BACKEND remains supported.
JOB_QUEUE_BACKEND=sqlite
